# All Black Limo SF — environment variables
# Copy this file to .env (locally) or set these on Vercel Project Settings → Environment Variables.

# Required: PostgreSQL connection string (Neon, Supabase, or any Postgres provider).
# Use the POOLED connection string here (the one with "-pooler" in the host).
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxxx-pooler.region.aws.neon.tech/allblacklimosf?sslmode=require"

# Required for Neon: the UNPOOLED connection string (no "-pooler" in the host).
# Prisma's build step runs `prisma db push`, which needs a direct (non-pgbouncer)
# connection — pooled/pgbouncer connections don't reliably support the schema
# push protocol and can fail with "prepared statement already exists" errors.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/allblacklimosf?sslmode=require"

# Optional: public site URL (used for canonical, sitemap, Open Graph). Defaults to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL="https://allblacklimosf.com"

# Optional: Google Tag Manager container id (e.g. GTM-XXXXXX). Leave blank to disable.
NEXT_PUBLIC_GTM_ID=""

# Optional: Google Analytics 4 measurement id (e.g. G-XXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=""

# Optional: Google Maps Places API key (used only to enhance /book-now address autocomplete).
# If blank, the site falls back to the free Photon/Komoot geocoder automatically.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
